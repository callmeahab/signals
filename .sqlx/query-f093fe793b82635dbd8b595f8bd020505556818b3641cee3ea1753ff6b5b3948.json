  "query": "INSERT INTO callers(project_id,kind,external_id,label,first_seen,last_seen) SELECT $1,u.* FROM unnest($2::text[],$3::text[],$4::text[],$5::timestamptz[],$6::timestamptz[]) u ON CONFLICT(project_id,kind,external_id) DO UPDATE SET first_seen=LEAST(callers.first_seen,EXCLUDED.first_seen),last_seen=GREATEST(callers.last_seen,EXCLUDED.last_seen) RETURNING id,kind,external_id",
