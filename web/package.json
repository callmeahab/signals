{
  "name": "signals-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "vite --config apps/dashboard/vite.config.ts --host 127.0.0.1",
    "build": "npm run build:ui && tsc --noEmit && vite build --config apps/dashboard/vite.config.ts",
    "check": "npm run build:ui && tsc --noEmit && eslint .",
    "qa": "node scripts/visual-qa.mjs",
    "qa:backend": "node scripts/backend-qa.mjs",
    "build:ui": "tsc -p packages/ui/tsconfig.build.json && node scripts/copy-ui.mjs",
    "test": "node scripts/test.mjs",
    "test:next": "node scripts/test-next-host.mjs"
  },
  "dependencies": {
    "@mcpramen/signals-ui": "*",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "postcss": "^8.5.28"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
