{
  "name": "basic",
  "description": "A stateful Streamable HTTP example server driven through: initialize, tools/list, three tool calls (success, isError result, cancelled), resources/read, disconnect. See README.md in this directory for the exact server and client steps.",
  "transport": "streamable-http",
  "sdk_settings": {
    "SIGNALS_SAMPLE_REQUESTS": "1",
    "SIGNALS_CAPTURE_ARGS": "false",
    "SIGNALS_TRUST_PROXY": "false"
  },
  "server": {
    "name": "signals-conformance-example",
    "tools": {
      "echo": "arguments {message: string}; returns one text content `echo: <message>`",
      "fail": "no arguments; returns an isError result with one text content `boom`",
      "slow": "arguments {ms: integer}; sleeps for `ms` milliseconds honouring cancellation, then returns one text content `done`"
    },
    "resources": {
      "demo://hello": "mimeType text/plain, text `hello`"
    }
  },
  "steps": [
    "1. Client opens a Streamable HTTP session and sends `initialize` (any protocol version the server supports), then `notifications/initialized`.",
    "2. Client sends `tools/list`.",
    "3. Client calls tool `echo` with arguments {\"message\":\"hello\"} and receives a success result.",
    "4. Client calls tool `fail` with arguments {} and receives a result with isError: true.",
    "5. Client calls tool `slow` with arguments {\"ms\":10000} and, within 500 ms, sends `notifications/cancelled` for that request id. The client does not wait for a response.",
    "6. Client reads resource `demo://hello`.",
    "7. Client terminates the session (HTTP DELETE with the session id) and closes the transport.",
    "8. The SDK flushes (process exit or an explicit flush()); the mock collector records every event."
  ],
  "tolerances": { "bytes": 16, "bytes_percent": 10 },
  "strict_attrs": false,
  "require_optional": false,
  "source": {
    "sdk": { "$match": "oneOf", "values": ["node", "python"] },
    "sdk_version": { "$match": "string", "minLength": 1 },
    "server_name": "signals-conformance-example",
    "server_version": { "$match": "string", "minLength": 1 }
  },
  "events": [
    {
      "type": "session.started",
      "session_id": "<session:1>",
      "attrs": {
        "transport": "streamable-http",
        "derived": { "$match": "ifPresent", "then": false }
      }
    },
    {
      "type": "mcp.initialize",
      "session_id": "<session:1>",
      "client": { "name": { "$match": "string", "minLength": 1 }, "version": { "$match": "string" } },
      "attrs": {
        "requested_protocol_version": { "$match": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "client_capabilities": { "$match": "array" },
        "server_capabilities": { "$match": "array", "contains": ["tools", "resources"] },
        "duration_ms": { "$match": "ifPresent", "then": { "$match": "integer", "min": 0, "max": 5000 } },
        "is_error": { "$match": "ifPresent", "then": false },
        "error_kind": { "$match": "absent" }
      }
    },
    {
      "type": "tools.listed",
      "optional": true,
      "note": "Contract 1.1.0. An SDK that emits the catalogue snapshot is matched here; one that does not is skipped, so this scenario holds for both. Its `ts` is the start of the `tools/list` request handling, the same instant as the `mcp.request` below, and the CONTRACT.md §6 tie-break therefore puts it first. The scenario is stricter than the schema on purpose: every attribute is optional on the wire, but an SDK that emits a snapshot at all must say what triggered it and what the catalogue holds. Run `compare --require-optional` to make this expectation mandatory.",
      "session_id": "<session:1>",
      "attrs": {
        "source": "list",
        "count": 3,
        "tools": [
          { "name": { "$match": "oneOf", "values": ["echo", "fail", "slow"] } },
          { "name": { "$match": "oneOf", "values": ["echo", "fail", "slow"] } },
          { "name": { "$match": "oneOf", "values": ["echo", "fail", "slow"] } }
        ],
        "truncated": { "$match": "ifPresent", "then": false },
        "catalog_hash": { "$match": "ifPresent", "then": { "$match": "string", "minLength": 1, "maxLength": 64 } },
        "duration_ms": { "$match": "ifPresent", "then": { "$match": "integer", "min": 0, "max": 5000 } },
        "is_error": { "$match": "ifPresent", "then": false }
      }
    },
    {
      "type": "mcp.request",
      "session_id": "<session:1>",
      "attrs": {
        "method": "tools/list",
        "duration_ms": { "$match": "integer", "min": 0 },
        "is_error": false,
        "error_kind": { "$match": "absent" },
        "error_code": { "$match": "absent" },
        "request_id": { "$match": "ifPresent", "then": { "$match": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    {
      "type": "tool.called",
      "session_id": "<session:1>",
      "attrs": {
        "tool": "echo",
        "duration_ms": { "$match": "integer", "min": 0, "max": 5000 },
        "is_error": false,
        "cancelled": false,
        "input_bytes": 19,
        "output_bytes": 38,
        "output_kinds": ["text"],
        "output_chars": { "$match": "ifPresent", "then": 11 },
        "output_items": { "$match": "ifPresent", "then": 1 },
        "input_schema_valid": { "$match": "ifPresent", "then": true },
        "error_message": { "$match": "absent" },
        "error_kind": { "$match": "absent" },
        "error_code": { "$match": "absent" },
        "request_id": { "$match": "ifPresent", "then": { "$match": "string", "minLength": 1, "maxLength": 64 } },
        "args": { "$match": "absent" }
      }
    },
    {
      "type": "tool.called",
      "session_id": "<session:1>",
      "attrs": {
        "tool": "fail",
        "duration_ms": { "$match": "integer", "min": 0, "max": 5000 },
        "is_error": true,
        "cancelled": false,
        "input_bytes": 2,
        "output_bytes": 31,
        "output_kinds": ["text"],
        "output_chars": { "$match": "ifPresent", "then": 4 },
        "output_items": { "$match": "ifPresent", "then": 1 },
        "error_message": "boom",
        "error_kind": { "$match": "ifPresent", "then": "tool" },
        "error_code": { "$match": "absent" },
        "args": { "$match": "absent" }
      }
    },
    {
      "type": "tool.called",
      "session_id": "<session:1>",
      "attrs": {
        "tool": "slow",
        "duration_ms": { "$match": "integer", "min": 0, "max": 5000 },
        "is_error": false,
        "cancelled": true,
        "input_bytes": 12,
        "output_bytes": 0,
        "output_kinds": [],
        "output_chars": { "$match": "ifPresent", "then": 0 },
        "output_items": { "$match": "ifPresent", "then": 0 },
        "error_kind": { "$match": "ifPresent", "then": "cancelled" },
        "args": { "$match": "absent" }
      }
    },
    {
      "type": "resource.read",
      "session_id": "<session:1>",
      "attrs": {
        "uri": "demo://hello",
        "duration_ms": { "$match": "integer", "min": 0, "max": 5000 },
        "is_error": false,
        "output_bytes": 63,
        "output_chars": { "$match": "ifPresent", "then": 5 },
        "output_items": { "$match": "ifPresent", "then": 1 },
        "error_kind": { "$match": "absent" }
      }
    },
    {
      "type": "session.ended",
      "session_id": "<session:1>",
      "attrs": { "duration_ms": { "$match": "integer", "min": 0 }, "reason": "client" }
    }
  ]
}
