{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signals:development:event:1",
  "title": "WireEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "ts",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "session.start",
        "session.end",
        "tool.call",
        "request",
        "resource.read",
        "prompt.get"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "caller": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "tool": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 2147483647
    },
    "is_error": {
      "type": "boolean"
    },
    "client_name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "client_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "attrs": {
      "type": "object"
    }
  },
  "description": "Provisional development event; not the official signals-spec v1 contract."
}
